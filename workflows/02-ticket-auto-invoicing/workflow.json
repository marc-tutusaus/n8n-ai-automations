    {
      "parameters": {
        "jsCode": "/**\n * Pick the text that goes on the delivery note:\n * - the FIRST article (by created_at) written by an agent (sender_id === 2 in Zammad)\n * - fallback: the first article with a non-empty body\n */\nconst base = $node['Build payload'].json ?? {};\n\n// n8n may return the array as one item or split it into many items\nlet articles = items[0]?.json;\nif (typeof articles === 'string') {\n  try { articles = JSON.parse(articles); } catch (e) { articles = []; }\n}\nif (!Array.isArray(articles)) articles = items.map(i => i.json);\nif (!Array.isArray(articles)) articles = [];\n\nconst sorted = articles.slice().sort((a, b) => new Date(a.created_at) - new Date(b.created_at));\nconst hasBody = a => a && typeof a.body === 'string' && a.body.trim() !== '';\n\nconst chosen = sorted.find(a => hasBody(a) && Number(a.sender_id) === 2) ?? sorted.find(hasBody) ?? null;\n\nreturn [{\n  json: {\n    ...base,\n    firstNoteBody: chosen?.body ? String(chosen.body).trim() : '',\n    chosen_article_id: chosen?.id ?? null\n  }\n}];\n"
      },
      "name": "Extract first agent note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        336
      ],
      "id": "6630bcb9-fb9f-443d-9458-b83fe2801dff"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Validate the minimum fields required by the billing API and build its payload.\n * If something is missing, prepare an internal note instead of failing silently.\n */\nconst p = items[0]?.json ?? {};\n\nconst required = ['ticket_id', 'customer_id', 'technician_id', 'billed_minutes', 'maintenance_type', 'service_id'];\nconst missing = required.filter(k => p[k] === undefined || p[k] === null || p[k] === '' || Number.isNaN(Number(p[k])));\nconst canInvoice = missing.length === 0;\n\n// The first agent note is the best description of the work done\nconst issue = p.firstNoteBody || p.issue || '';\n\nconst deliveryNotePayload = canInvoice ? {\n  customer_id: Number(p.customer_id),\n  technician_id: Number(p.technician_id),\n  billed_minutes: Number(p.billed_minutes),\n  maintenance_type: Number(p.maintenance_type),\n  service_id: Number(p.service_id),\n  issue: String(issue),\n  resolution: String(p.resolution || ''),\n} : null;\n\nconst noteBodyMissing =\n  `AUTOMATIC INVOICING (n8n)\\n` +\n  `The delivery note could not be created.\\n` +\n  `Missing fields: ${missing.join(', ')}\\n`;\n\nreturn [{\n  json: {\n    ticket_id: p.ticket_id ? Number(p.ticket_id) : null,\n    canInvoice,\n    missing,\n    deliveryNotePayload,\n    noteBodyMissing\n  }\n}];\n"
      },
