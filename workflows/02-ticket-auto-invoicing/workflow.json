    {
      "parameters": {
        "jsCode": "/**\n * Build the billing payload directly from the helpdesk webhook body.\n * Expected fields:\n *   ticket_id, customer_id, technician_id, billed_minutes,\n *   maintenance_type, service_id, issue, resolution\n */\nconst incomingRoot = $node['Webhook: invoice ticket'].json;\nconst incoming = incomingRoot.body ?? incomingRoot;\n\nreturn [{\n  json: {\n    ticket_id: Number(incoming.ticket_id),\n    customer_id: Number(incoming.customer_id),\n    technician_id: Number(incoming.technician_id),\n    billed_minutes: Math.round(Number(incoming.billed_minutes ?? 0)),\n    maintenance_type: Number(incoming.maintenance_type ?? 1),\n    service_id: Number(incoming.service_id ?? 1),\n    issue: String(incoming.issue ?? ''),\n    resolution: String(incoming.resolution ?? '')\n  }\n}];\n"
      },
      "name": "Build payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1152,
        320
      ],
      "id": "48680e64-3efb-4e04-a62b-256feb3bbc26"
    },
