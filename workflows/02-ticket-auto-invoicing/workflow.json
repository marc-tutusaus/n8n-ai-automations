    {
      "parameters": {
        "jsCode": "// Build a success / error note from the billing API response\nconst ticket_id = $node['Validate + prepare delivery note'].json.ticket_id;\nconst res = items[0].json ?? {};\nconst status = res.status ?? 'unknown';\n\nconst noteBody = (status === 'ok' && res.number)\n  ? `AUTOMATIC INVOICING (n8n)\\nDelivery note created.\\nNumber: ${res.number}\\n` + (res.url ? `Link: ${res.url}\\n` : '')\n  : `AUTOMATIC INVOICING (n8n)\\nError creating the delivery note.\\nStatus: ${status}\\n` + (res.message ? `Message: ${res.message}\\n` : '');\n\nreturn [{ json: { ticket_id, status, number: res.number ?? null, url: res.url ?? null, noteBody } }];\n"
      },
