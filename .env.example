# ── n8n ─────────────────────────────────────────────────────
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Madrid
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
# The workflows read endpoints from environment variables ($env.*)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ── Endpoints used by the workflows ─────────────────────────
ZAMMAD_BASE_URL=https://helpdesk.example.com
BILLING_API_URL=https://billing.example.com/api
TEAMS_WEBHOOK_URL=
TRIAGE_LOG_DRIVE_ID=
TRIAGE_LOG_ITEM_ID=
