    {
      "parameters": {
        "path": "contact",
        "formTitle": "Talk to us",
        "formDescription": "Tell us what you need and a consultant will contact you within one working day.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Company",
              "requiredField": true
            },
            {
              "fieldLabel": "Company size",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "1-10"
                  },
                  {
                    "option": "11-50"
                  },
                  {
                    "option": "51-250"
                  },
                  {
                    "option": "250+"
                  }
                ]
              }
            },
            {
              "fieldLabel": "How can we help?",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Send"
        }
      },
      "id": "945fb2ff-d865-4a33-a5f7-4643f95e2535",
      "name": "Contact form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.3,
      "position": [
        0,
        0
      ],
      "webhookId": "ca439461-0a1f-4586-8981-9a82c5c21e69"
    },
    {
      "parameters": {
        "jsCode": "// Normalize the form submission (field labels come from the Form Trigger).\nconst f = $json;\nreturn [{ json: {\n  name: f['Name'], email: String(f['Email'] || '').trim().toLowerCase(), company: f['Company'],\n  employees: f['Company size'], need: f['How can we help?'], submitted_at: f.submittedAt ?? new Date().toISOString(),\n} }];\n"
      },
      "id": "ea4d0816-ff1d-4eae-bf51-b0c8c6681e29",
      "name": "Normalize submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const schema = {\n  type: 'object', additionalProperties: false,\n  properties: {\n    fit_score: { type: 'integer', minimum: 0, maximum: 100 },\n    need_summary: { type: 'string' },\n    recommended_service: { type: 'string' },\n    language: { type: 'string' },\n    welcome_subject: { type: 'string' },\n    welcome_body: { type: 'string' },\n  },\n  required: ['fit_score', 'need_summary', 'recommended_service', 'language', 'welcome_subject', 'welcome_body'],\n};\n\nreturn [{ json: {\n  ...$json,\n  openai_payload: {\n    model: $env.OPENAI_MODEL || 'gpt-5.6-luna',\n    instructions: 'You qualify inbound leads for a B2B services company and write a personal welcome email. fit_score: how well ' + 'the need matches the services (0-100). The welcome email: in the lead language, warm, 4-6 lines, mention their ' + 'need in your own words, say a consultant will contact them within one working day. Never mention prices.' + ($env.COMPANY_SERVICES ? '\\n\\nServices we offer:\\n' + $env.COMPANY_SERVICES : ''),\n    input: `Name: ${$json.name}\\nCompany: ${$json.company}\\nCompany size: ${$json.employees}\\nNeed: ${$json.need}`,\n    text: { format: { type: 'json_schema', name: 'lead_qualification', strict: true, schema } },\n  },\n} }];\n"
      },
      "id": "91f9c454-93fb-43b0-a071-62bbb55c26f3",
      "name": "Build qualification request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.openai_payload }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "4633779d-4da1-400b-ade1-089efc524407",
      "name": "OpenAI: qualify + write welcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "function parseResponse(res) {\n  const message = (res.output || []).find(o => o.type === 'message');\n  const part = message?.content?.find(c => c.type === 'output_text' || c.type === 'refusal');\n  if (!part || part.type === 'refusal') throw new Error('The model returned no usable answer: ' + JSON.stringify(res).slice(0, 300));\n  return JSON.parse(part.text);\n}\n\n// Final priority = model fit + a deterministic size rule (auditable, easy to tune).\nconst lead = $('Normalize submission').item.json;\nconst q = parseResponse($json);\nconst sizeBonus = { '1-10': 0, '11-50': 10, '51-250': 20, '250+': 25 }[lead.employees] ?? 0;\nconst score = Math.min(100, q.fit_score + sizeBonus);\nconst tier = score >= 75 ? 'hot' : score >= 45 ? 'warm' : 'cold';\nreturn [{ json: { ...lead, ...q, score, tier } }];\n"
      },
      "id": "2daacfba-bafe-421e-bc61-0e8847cb93e7",
      "name": "Score lead in code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const l = $json;\nreturn [{ json: { submitted_at: l.submitted_at, name: l.name, email: l.email, company: l.company, company_size: l.employees,\n  need: l.need, need_summary: l.need_summary, recommended_service: l.recommended_service, score: l.score, tier: l.tier,\n  status: 'new' } }];\n"
      },
      "id": "d34fbd53-307a-43de-954f-22e5f3eed8d6",
      "name": "Build CRM row",
