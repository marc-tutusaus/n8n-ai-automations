      "parameters": {
        "jsCode": "const d = $('Decide name and folder').item.json;\nreturn [{ json: { processed_at: d.processed_at, status: d.status, doc_type: d.doc_type, counterparty: d.counterparty,\n  document_date: d.document_date, reference: d.reference, total_amount: d.total_amount, currency: d.currency,\n  summary: d.summary, confidence: d.confidence, file_name: d.new_name, original_name: d.original_name, file_url: d.file_url } }];\n"
      },
