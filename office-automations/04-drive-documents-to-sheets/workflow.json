      "id": "2f0f11f6-aeb5-45ee-abb7-f832a33ccd9a",
      "name": "Extract PDF text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const schema = {\n  type: 'object', additionalProperties: false,\n  properties: {\n    doc_type: { type: 'string', enum: ['invoice', 'receipt', 'delivery_note', 'quote', 'contract', 'other'] },\n    counterparty: { type: 'string' },\n    document_date: { type: 'string', description: 'YYYY-MM-DD or empty' },\n    reference: { type: 'string' },\n    total_amount: { type: ['number', 'null'] },\n    currency: { type: 'string' },\n    summary: { type: 'string' },\n    confidence: { type: 'integer', minimum: 0, maximum: 100 },\n  },\n  required: ['doc_type', 'counterparty', 'document_date', 'reference', 'total_amount', 'currency', 'summary', 'confidence'],\n};\n\nreturn [{ json: {\n  ...$json,\n  openai_payload: {\n    model: $env.OPENAI_MODEL || 'gpt-5.6-luna',\n    instructions: 'Identify this business document and extract its key fields. Copy values as printed; do not calculate or ' + 'guess. summary: one sentence. Dates as YYYY-MM-DD; empty string or null when missing.',\n    input: `File name: ${$('New file in inbox folder').item.json.name}\\n\\n${String($json.text || '').slice(0, 15000)}`,\n    text: { format: { type: 'json_schema', name: 'document_extraction', strict: true, schema } },\n  },\n} }];\n"
      },
      "id": "3c9b13a2-c2d7-4136-b657-9c1ecf4961e4",
      "name": "Build extraction request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.openai_payload }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "188c2bb4-d727-467f-946b-cae4309f553b",
      "name": "OpenAI: identify document",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "function parseResponse(res) {\n  const message = (res.output || []).find(o => o.type === 'message');\n  const part = message?.content?.find(c => c.type === 'output_text' || c.type === 'refusal');\n  if (!part || part.type === 'refusal') throw new Error('The model returned no usable answer: ' + JSON.stringify(res).slice(0, 300));\n  return JSON.parse(part.text);\n}\n\n// Standard file name and destination are decided in code.\nconst file = $('New file in inbox folder').item.json;\nconst d = parseResponse($json);\nconst slug = s => String(s || 'unknown').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^A-Za-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40) || 'unknown';\nconst date = /^\\d{4}-\\d{2}-\\d{2}$/.test(d.document_date) ? d.document_date : 'no-date';\nconst ext = (file.name.match(/\\.[A-Za-z0-9]+$/) || ['.pdf'])[0];\nconst needsReview = d.confidence < 70 || d.doc_type === 'other' || date === 'no-date';\n\nreturn [{ json: {\n  ...d,\n  file_id: file.id,\n  original_name: file.name,\n  new_name: `${date}_${d.doc_type}_${slug(d.counterparty)}${d.reference ? '_' + slug(d.reference) : ''}${ext}`,\n  target_folder: needsReview ? $env.DRIVE_REVIEW_FOLDER_ID : $env.DRIVE_PROCESSED_FOLDER_ID,\n  status: needsReview ? 'needs review' : 'processed',\n  file_url: `https://drive.google.com/file/d/${file.id}/view`,\n  processed_at: new Date().toISOString(),\n} }];\n"
      },
      "id": "e42622bb-127e-4eab-b351-f8d06c170d47",
      "name": "Decide name and folder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
